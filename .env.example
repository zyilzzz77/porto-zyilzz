# URL publik utama. Wajib diisi di Vercel dengan domain produksi.
# Tanpa variabel ini, canonical dan sitemap bisa menunjuk ke URL preview deployment.
NEXT_PUBLIC_SITE_URL=https://zyilzz.my.id

# Opsional: token meta verification dari Google Search Console.
GOOGLE_SITE_VERIFICATION=

# Opsional: token meta verification dari Bing Webmaster Tools.
BING_SITE_VERIFICATION=

# LYDEV Pay — API key project untuk panggilan server-to-server.
# JANGAN di-prefix NEXT_PUBLIC_, key ini hanya boleh dibaca di server.
LYPAY_API_KEY=

# Webhook signing secret dari dashboard LYDEV Pay (berawalan lywhsec_).
# Dipakai untuk memverifikasi signature webhook payment.paid.
LYDEV_WEBHOOK_SECRET=

# Koneksi Postgres dari Neon atau Vercel Postgres.
DATABASE_URL=
